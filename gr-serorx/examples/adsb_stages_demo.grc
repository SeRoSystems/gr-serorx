connections:
- [serorx_adsb_fields_0, lines, log_fields, in]
- [serorx_adsb_fields_0, lines, log_overview, in]
- [serorx_grx_source_0, '0', qtgui_waterfall_sink_x_0, '0']
- [serorx_grx_source_0, '0', serorx_modes_demod_0, '0']
