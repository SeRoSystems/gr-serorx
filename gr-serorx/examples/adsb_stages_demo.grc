options:
  parameters:
    alias: ''
    author: SeRo Systems GmbH
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: ADS-B decoding in stages against a receiver on host
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: adsb_stages_demo
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: ADS-B stages demo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: host
  id: variable
  parameters:
    comment: ''
    value: '''localhost'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 16.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 12e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 16.0]
    rotation: 0
    state: enabled
- name: log_fields
  id: serorx_qt_msg_log
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gui_hint: tabs@3
    max_lines: '500'
    title: Decoded ADS-B
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 344.0]
    rotation: 0
    state: enabled
- name: log_overview
